# Postgres connection string. Railway's Postgres plugin provides this automatically
# when linked to the app service.
DATABASE_URL="postgresql://user:password@localhost:5432/fulfillment_tracker?schema=public"

# Long random string used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Optional — used only by `npm run db:seed` to set initial passwords for the
# three seeded accounts. If unset, random passwords are generated and printed
# once. Not needed after the first deploy.
SEED_CAMILLE_PASSWORD=""
SEED_MARY_PASSWORD=""
SEED_EMILIE_PASSWORD=""
