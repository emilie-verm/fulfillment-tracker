// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FULFILLMENT // Camille: stock levels, full exception access, tracking/fulfillment
  OUTREACH // Mary: full exception access, read-only stock
  ADMIN // Emilie: full access, can confirm resolution
  VIEWER // Read-only across everything — for sharing progress with leadership
}

enum StockStatus {
  OUT_OF_STOCK
  LOW_STOCK
  HIGH_STOCK
}

enum ExceptionType {
  OUT_OF_STOCK
  DAMAGED
  LOST
  WRONG_ITEM
  ADDRESS_UPDATE
  OTHER
}

// Where a single order-line exception currently sits in the resolution process.
// Only CONFIRMED_RESOLVED or CLOSED_NO_RESPONSE count as "crossed off".
enum ExceptionStage {
  LOGGED // Camille logged the exception
  OUTREACH_SENT // Mary emailed the customer
  CUSTOMER_RESPONDED // Customer replied and made a choice
  FULFILLED // Camille shipped the replacement / took the fulfillment action
  CONFIRMED_RESOLVED // Admin verified the corrected order actually went out / refund landed
  CLOSED_NO_RESPONSE // Customer never responded after follow-up; parked, not "forgotten"
}

enum ResolutionType {
  REPLACEMENT_SHIPPED
  REFUNDED
  NO_RESPONSE
  ADDRESS_UPDATED
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  // Deactivating (not deleting) preserves the audit trail — exceptions,
  // comments, and stock checks all reference who did them, and this app's
  // whole point is that history. A deactivated user just can't log in.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  stockChecks             StockCheck[]        @relation("StockCheckedBy")
  stockChecksWebsiteBy    StockCheck[]        @relation("StockCheckWebsiteUpdatedBy")
  stockChecksArchivedBy   StockCheck[]        @relation("StockCheckArchivedBy")
  stockCheckComments      StockCheckComment[] @relation("StockCheckCommentAuthor")
  exceptionsCreated       Exception[]         @relation("ExceptionCreatedBy")
  exceptionsUpdated       Exception[]         @relation("ExceptionLastUpdatedBy")
  exceptionsConfirmed     Exception[]         @relation("ExceptionConfirmedBy")
  exceptionsClaimFiledBy  Exception[]         @relation("ExceptionCarrierClaimFiledBy")
  exceptionEvents         ExceptionEvent[]    @relation("ExceptionEventActor")
  exceptionComments       ExceptionComment[]  @relation("ExceptionCommentAuthor")
  notifications           Notification[]
}

// Append-only log of physical stock checks. "Current" status for a product
// is whichever check is most recent.
model StockCheck {
  id          String      @id @default(cuid())
  productName String
  status      StockStatus
  notes       String?

  checkedById String
  checkedBy   User     @relation("StockCheckedBy", fields: [checkedById], references: [id])
  checkedAt   DateTime @default(now())

  // Admin-only confirmation that the website (Shopify) was actually updated
  // to match this stock report — separate from just logging it, so Camille
  // can see it's been applied, not just recorded.
  websiteUpdatedAt   DateTime?
  websiteUpdatedById String?
  websiteUpdatedBy   User?     @relation("StockCheckWebsiteUpdatedBy", fields: [websiteUpdatedById], references: [id])

  // Dismisses this entry from the active Out of stock/Low/High tables into
  // a separate Archived section, without deleting it — e.g. once handled
  // but not yet restocked. A fresh check on the same product always shows
  // normally regardless of this, since it's a new row with archivedAt unset.
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("StockCheckArchivedBy", fields: [archivedById], references: [id])

  comments      StockCheckComment[]
  notifications Notification[]

  @@index([productName, checkedAt])
}

// Discussion thread per stock check entry — e.g. a restock request tied to
// the specific OOS/low report it's about, separate from the structured
// Notes field captured when the check was logged.
model StockCheckComment {
  id           String     @id @default(cuid())
  stockCheckId String
  stockCheck   StockCheck @relation(fields: [stockCheckId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation("StockCheckCommentAuthor", fields: [authorId], references: [id])
  body         String
  createdAt    DateTime   @default(now())

  @@index([stockCheckId, createdAt])
}

model Exception {
  id            String        @id @default(cuid())
  orderNumber   String
  productName   String
  exceptionType ExceptionType @default(OUT_OF_STOCK)

  stage          ExceptionStage @default(LOGGED)
  stageChangedAt DateTime       @default(now())

  // Camille's fields
  fulfillmentNotes String?
  trackingNumber   String?
  carrier          String?
  shippedAt        DateTime?

  // Mary's fields
  outreachNotes  String?
  customerChoice String?

  // ADDRESS_UPDATE exceptions skip outreach/customer-response entirely —
  // the corrected address is captured directly, then this moves straight
  // from LOGGED to FULFILLED once someone's applied it in ShipStation.
  correctedAddress String?

  // Independent of the main resolution flow — DAMAGED/LOST exceptions may
  // also need a claim filed with the carrier (UPS/FedEx) to recover cost,
  // which has nothing to do with whether the customer's been made whole.
  carrierClaimFiledAt   DateTime?
  carrierClaimFiledById String?
  carrierClaimFiledBy   User?     @relation("ExceptionCarrierClaimFiledBy", fields: [carrierClaimFiledById], references: [id])
  carrierClaimReference String?

  // Set once the exception reaches a terminal stage
  resolutionType ResolutionType?

  // Admin-only verification
  confirmedResolvedAt   DateTime?
  confirmedResolvedById String?
  confirmedResolvedBy   User?     @relation("ExceptionConfirmedBy", fields: [confirmedResolvedById], references: [id])

  createdById String
  createdBy   User     @relation("ExceptionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  lastUpdatedById String?
  lastUpdatedBy   User?    @relation("ExceptionLastUpdatedBy", fields: [lastUpdatedById], references: [id])
  updatedAt       DateTime @updatedAt

  events        ExceptionEvent[]
  comments      ExceptionComment[]
  notifications Notification[]

  @@index([orderNumber])
  @@index([stage])
  @@index([productName])
}

// Human-readable audit trail: every stage change / field edit on an exception.
model ExceptionEvent {
  id          String   @id @default(cuid())
  exceptionId String
  exception   Exception @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User      @relation("ExceptionEventActor", fields: [actorId], references: [id])
  action      String
  createdAt   DateTime  @default(now())

  @@index([exceptionId, createdAt])
}

// Free-form discussion thread per exception — tracking updates, replacement
// requests, anything that doesn't fit a structured field. Separate from
// ExceptionEvent, which is system-generated, not user-authored.
model ExceptionComment {
  id          String    @id @default(cuid())
  exceptionId String
  exception   Exception @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation("ExceptionCommentAuthor", fields: [authorId], references: [id])
  body        String
  createdAt   DateTime  @default(now())

  @@index([exceptionId, createdAt])
}

// In-app notification, created when responsibility for an exception hands
// off to another role (e.g. customer response recorded -> fulfillment is
// notified it's ready to ship). Surfaced via a bell icon; no email/SMS.
model Notification {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exceptionId  String?
  exception    Exception?  @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  stockCheckId String?
  stockCheck   StockCheck? @relation(fields: [stockCheckId], references: [id], onDelete: Cascade)
  message      String
  readAt       DateTime?
  createdAt    DateTime    @default(now())

  @@index([userId, readAt])
}
